# Voice-Based Concept Understanding Analyser Environment Variables
# Copy this file to .env and fill in your actual key. DO NOT commit .env to GitHub.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Audio & Analysis Configuration
SIMILARITY_THRESHOLD=0.75
WHISPER_MODEL=base
MAX_AUDIO_DURATION_SEC=300
PORT=8501
